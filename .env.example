# ------------------------------------------------------------------
# Copy this file to ".env" and replace the placeholder values with
# credentials from your own SANDBOX / TEST accounts.
#
# .env is listed in .gitignore, so your real values never get committed.
# Every value below is fake.
# ------------------------------------------------------------------

# --- HubSpot ---------------------------------------------------------
# Create a private app in a HubSpot developer test account.
# Grant only the scopes you need (automation, crm.objects.*, crm.lists.*).
HUBSPOT_ACCESS_TOKEN=replace_with_your_hubspot_private_app_token

# --- Salesforce ------------------------------------------------------
# Use a Developer Edition org or a sandbox, never production.
SALESFORCE_INSTANCE_URL=https://your-dev-org.my.salesforce.com
SALESFORCE_CLIENT_ID=replace_with_your_connected_app_client_id
SALESFORCE_CLIENT_SECRET=replace_with_your_connected_app_client_secret

# --- Outreach --------------------------------------------------------
# Outreach issues a NEW refresh token every time you refresh, and the old
# one stops working. The server saves each new one to the file below.
OUTREACH_CLIENT_ID=replace_with_your_outreach_app_client_id
OUTREACH_CLIENT_SECRET=replace_with_your_outreach_app_client_secret
OUTREACH_REDIRECT_URI=https://localhost/outreach/callback
OUTREACH_TOKEN_FILE=.outreach-token.json
